# Build output
bin/
build/bin/
*.syso

# go-task's checksum cache, written by `wails3 task`
.task/

# Generated from the Go services by `wails3 generate bindings -b`, plus the
# bundled runtime `wails3 generate runtime` writes beside them.
# `wails3 build` and `wails3 task bindings` regenerate both before compiling.
frontend/bindings/

# The frontend build. main.go embeds this directory, and `wails3 build` creates
# it before compiling Go.
frontend/dist/
frontend/node_modules/

# Reference material: cloned repositories and notes, not part of the app.
references/

# Scratch space for screenshots taken while verifying the UI.
tmp/

# Built wheels and sdists for the pip-installable launcher under Cokpyt-pip.
Cokpyt-pip/dist/
